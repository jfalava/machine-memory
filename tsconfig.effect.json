{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  // Shared by every TypeScript workspace except docs (Astro has its own base).
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        // `effect-tsgo tsrs --noEmit` reports these diagnostics in the same pass as
        // type errors. Errors and warnings fail the typecheck; suggestions do not.
        // Every rule below is set explicitly so @effect/tsgo default changes cannot
        // move the gate; rules added upstream later start at their defaults.
        "ignoreEffectErrorsInTscExitCode": false,
        "ignoreEffectWarningsInTscExitCode": false,
        "ignoreEffectSuggestionsInTscExitCode": true,
        // Unstable Effect v4 modules this project depends on by design. Any other
        // unstable API fails unstableApiUsage.
        "allowedUnstableApis": [
          "effect/cli",
          "effect/http",
          "effect/FileSystem",
          "effect/PlatformError",
          "@effect/platform-bun/BunRuntime",
          "@effect/platform-bun/BunServices"
        ],
        "diagnosticSeverity": {
          // Correctness: everything fails, with two exceptions. anyUnknownInErrorContext
          // is off: CLI command handlers keep an unknown error channel by design
          // (cli/src/cli/runtime/command.ts). schemaClassMissingBrand stays a suggestion:
          // its hits are Schema.TaggedError classes, already discriminated by _tag.
          "anyUnknownInErrorContext": "off",
          "classSelfMismatch": "error",
          "duplicatePackage": "error",
          "effectFnImplicitAny": "error",
          "errorPayloadShadowsName": "error",
          "experimentalApiUsage": "error",
          "floatingEffect": "error",
          "floatingEffectInVitest": "error",
          "genericEffectServices": "error",
          "missingEffectContext": "error",
          "missingEffectError": "error",
          "missingLayerContext": "error",
          "missingReturnYieldStar": "error",
          "missingStarInYieldEffectGen": "error",
          "nonObjectEffectServiceType": "error",
          "obsoleteMatchImport": "error",
          "obsoleteSchemaImport": "error",
          "outdatedApi": "error",
          "overriddenSchemaConstructor": "error",
          "promiseInEffectSuccess": "error",
          "schemaClassMissingBrand": "suggestion",
          "schemaClassObjectLiteral": "error",
          "schemaLiteralNonFinite": "error",
          "schemaOpaqueInstanceMember": "error",
          "unsafeEffectTypeAssertion": "error",
          "unstableApiUsage": "error",

          // Anti-patterns: everything fails. strictEffectProvide stays off because
          // entry points (Workers, CLI main) provide their layers by design.
          "catchUnfailableEffect": "error",
          "effectFnIife": "error",
          "effectGenUsesAdapter": "error",
          "effectInFailure": "error",
          "effectInVoidSuccess": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "layerMergeAllWithDependencies": "error",
          "lazyEffect": "error",
          "lazyPromiseInEffectSync": "error",
          "leakingRequirements": "error",
          "multipleEffectProvide": "error",
          "preferUnsafeConstructor": "error",
          "returnEffectInGen": "error",
          "runEffectInsideEffect": "error",
          "schemaSyncInEffect": "error",
          "scopeInLayerEffect": "error",
          "strictEffectProvide": "off",
          "tryCatchInEffectGen": "error",
          "unknownInEffectCatch": "error",

          // Effect-native inside Effect code: use Clock, Random, HttpClient, Config, etc.
          "abortControllerInEffect": "error",
          "cryptoRandomUUIDInEffect": "error",
          "globalDateInEffect": "error",
          "globalFetchInEffect": "error",
          "globalRandom": "error",
          "globalRandomInEffect": "error",
          "globalTimersInEffect": "error",
          "instanceOfSchema": "error",
          "processEnvInEffect": "error",

          // Effect-native outside Effect code: off. Worker fetch handlers, the OAuth
          // flow, CLI output and Node/Bun entry points are platform boundaries.
          // globalConsoleInEffect stays off because CLI commands print their results.
          "asyncFunction": "off",
          "cryptoRandomUUID": "off",
          "extendsNativeError": "off",
          "globalConsole": "off",
          "globalConsoleInEffect": "off",
          "globalDate": "off",
          "globalFetch": "off",
          "globalTimers": "off",
          "newPromise": "off",
          "nodeBuiltinImport": "off",
          "preferEffectArray": "off",
          "preferEffectRecord": "off",
          "preferEffectString": "off",
          "preferSchemaOverJson": "off",
          "processEnv": "off",
          "schemaSync": "off",

          // Style: mechanical simplifications fail. Kept as suggestions: effectFnOpportunity
          // (taste), schemaNumber and preferTypedSchemaDecoder (existing hits). Off:
          // import-style and service-shape rules that conflict with each other or the
          // codebase, and rules with hundreds of hits (strictBooleanExpressions,
          // missingPipeableSignature, newSchemaClass, deterministicKeys).
          "acquireReleaseDisposable": "error",
          "allOfMapToForEach": "error",
          "catchAllTagDispatchToCatchTag": "error",
          "catchAllToMapError": "error",
          "catchChainToFirstSuccessOf": "error",
          "catchConditionalRefailToCatchIf": "error",
          "catchDieToOrDie": "error",
          "catchIfTagToCatchTag": "error",
          "catchRefailToTapError": "error",
          "catchTagToCatchReason": "error",
          "catchToIgnore": "error",
          "catchToOrElseSucceed": "error",
          "deterministicKeys": "off",
          "effectDoNotation": "error",
          "effectFnOpportunity": "suggestion",
          "effectMapFlatten": "error",
          "effectMapVoid": "error",
          "effectSleepZeroToYieldNow": "error",
          "effectSucceedWithVoid": "error",
          "failCauseToConstructor": "error",
          "flatMapConditionalToFilterOrFail": "error",
          "flatMapIdentityToFlatten": "error",
          "flatMapIgnoredParamToAndThen": "error",
          "flatMapToMap": "error",
          "flatMapToTap": "error",
          "manualMetricTapToTrack": "error",
          "mapConstToAs": "error",
          "mapMapErrorToMapBoth": "error",
          "mapSomeToAsSome": "error",
          "matchEffectToMapBoth": "error",
          "matchEffectToMatch": "error",
          "missedPipeableOpportunity": "off",
          "missingEffectServiceDependency": "error",
          "missingPipeableSignature": "off",
          "multipleCatchTag": "error",
          "nestedEffectGenYield": "error",
          "newSchemaClass": "off",
          "optionMatchToFromOption": "error",
          "preferBarrelImport": "off",
          "preferNamespaceImport": "off",
          "preferSchemaTaggedError": "error",
          "preferSchemaTypeProperty": "error",
          "preferSucceedSomeOrNone": "error",
          "preferTypedSchemaDecoder": "suggestion",
          "provideLayerSucceedToProvideService": "error",
          "raceFirstWithSleepToTimeout": "error",
          "redundantMapError": "error",
          "redundantOrDie": "error",
          "redundantSchemaTagIdentifier": "error",
          "runOfExitToRunExit": "error",
          "schemaNumber": "suggestion",
          "schemaStructWithTag": "error",
          "schemaUnionOfLiterals": "error",
          "serviceNotAsClass": "off",
          "strictBooleanExpressions": "off",
          "syncToSucceed": "error",
          "timeoutCatchTagToTimeoutOrElse": "error",
          "unnecessaryArrowBlock": "off",
          "unnecessaryEffectGen": "error",
          "unnecessaryFailYieldableError": "error",
          "unnecessaryPipe": "error",
          "unnecessaryPipeChain": "error",
          "unnecessaryTypeofType": "error",

          // Maintainers: library API stability; not relevant to an application.
          "apiStabilityLeak": "off"
        }
      }
    ]
  }
}
