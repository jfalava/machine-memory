# Required for REST API auth (bound onto the API worker at deploy time).
MACHINE_MEMORY_DB_TOKEN=
# Optional naming / domain overrides (prefer machine-memory.deploy.json).
# MACHINE_MEMORY_STACK_NAME=machine-memory-remote-db
# MACHINE_MEMORY_DOMAIN=machine-memory.jfa.dev
# MACHINE_MEMORY_DEPLOY_DOCS=1

# Optional MCP OAuth (GitHub). Omit all three to leave MCP disabled (routes return 503).
# Callback URL on the GitHub OAuth app must be:
#   https://<router-host>/callback
# e.g. https://machine-memory.jfa.dev/callback
MACHINE_MEMORY_GITHUB_CLIENT_ID=
MACHINE_MEMORY_GITHUB_CLIENT_SECRET=
MACHINE_MEMORY_COOKIE_ENCRYPTION_KEY=
