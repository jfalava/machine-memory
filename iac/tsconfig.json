{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "bun-types"]
  },
  "include": ["alchemy.run.ts", "src/**/*.ts"],
  "exclude": ["test/**"]
}
