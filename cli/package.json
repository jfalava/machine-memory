{
  "name": "@machine-memory/cli",
  "version": "0.17.1",
  "bin": {
    "machine-memory": "src/app.ts"
  },
  "type": "module",
  "module": "src/app.ts",
  "scripts": {
    "build": "bun build --compile src/app.ts --outfile machine-memory",
    "build:all": "bun run build:darwin-arm64 && bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:windows-x64",
    "build:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 src/app.ts --outfile dist/machine-memory-darwin-arm64",
    "build:darwin-arm64:local": "bun build --compile --target=bun-darwin-arm64 src/app.ts --outfile dist/machine-memory-darwin-arm64 && codesign --force --deep --sign - dist/machine-memory-darwin-arm64",
    "build:darwin-x64": "bun build --compile --target=bun-darwin-x64 src/app.ts --outfile dist/machine-memory-darwin-x64",
    "build:linux-arm64": "bun build --compile --target=bun-linux-arm64 src/app.ts --outfile dist/machine-memory-linux-arm64",
    "build:linux-x64": "bun build --compile --target=bun-linux-x64 src/app.ts --outfile dist/machine-memory-linux-x64",
    "build:windows-x64": "bun build --compile --target=bun-windows-x64 src/app.ts --outfile dist/machine-memory-windows-x64.exe",
    "check": "oxlint && vitest run",
    "format": "oxfmt",
    "lint": "oxlint",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:effect",
    "@huggingface/tokenizers": "0.1.3",
    "@machine-memory/contract": "workspace:*",
    "effect": "catalog:effect",
    "picocolors": "1.1.1",
    "table": "6.9.0"
  },
  "devDependencies": {
    "bun-types": "catalog:types",
    "oxfmt": "catalog:maintenance",
    "oxlint": "catalog:maintenance",
    "oxlint-tsgolint": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:maintenance"
  }
}
