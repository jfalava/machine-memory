{
  "name": "@machine-memory/monorepo",
  "workspaces": {
    "packages": [
      "cli",
      "docs",
      "remote-db/*"
    ],
    "catalogs": {
      "effect": {
        "@effect/platform-node": "4.0.0-rc.110",
        "@effect/platform-bun": "4.0.0-rc.110",
        "@effect/sql-d1": "4.0.0-rc.110",
        "effect": "4.0.0-rc.110"
      },
      "types": {
        "@types/bun": "1.4.0"
      },
      "build": {
        "oxlint": "1.80.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "7.0.2",
        "wrangler": "4.124.0"
      },
      "maintenance": {
        "oxfmt": "0.64.0",
        "oxlint": "1.80.0",
        "vitest": "4.1.11"
      }
    }
  },
  "type": "module",
  "scripts": {
    "format": "bunx oxfmt",
    "check:global": "bun run --filter @machine-memory/cli --filter @machine-memory/docs --filter @machine-memory/remote-db-cloudflare check",
    "lint:global": "bun run --filter @machine-memory/cli --filter @machine-memory/docs --filter @machine-memory/remote-db-cloudflare lint",
    "format:global": "bun run --filter @machine-memory/cli --filter @machine-memory/docs --filter @machine-memory/remote-db-cloudflare format",
    "typecheck:global": "bun run --filter @machine-memory/cli --filter @machine-memory/docs --filter @machine-memory/remote-db-cloudflare typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "oxfmt": "catalog:maintenance",
    "oxlint": "catalog:build",
    "vite-tsconfig-paths": "6.1.1"
  },
  "packageManager": "bun@1.4.0"
}
