{
  "name": "@machine-memory/monorepo",
  "workspaces": {
    "packages": [
      "contract",
      "cli",
      "docs",
      "api",
      "mcp",
      "router",
      "iac"
    ],
    "catalogs": {
      "effect": {
        "@effect/platform-node": "4.1.4",
        "@effect/platform-bun": "4.1.4",
        "effect": "4.1.4"
      },
      "types": {
        "bun-types": "1.4.4",
        "@cloudflare/workers-types": "5.20261114.1"
      },
      "iac": {
        "alchemy": "2.0.0-beta.87",
        "@alchemy.run/cloudflare": "2.0.0-beta.87",
        "@alchemy.run/test": "2.0.0-beta.87"
      },
      "build": {
        "oxlint-tsgolint": "7.0.2007",
        "tsrs": "0.25.0-ts7.1.0-beta",
        "typescript": "7.0.2",
        "wrangler": "4.162.0"
      },
      "maintenance": {
        "oxfmt": "0.78.0",
        "oxlint": "1.93.0",
        "vitest": "5.1.0"
      }
    }
  },
  "type": "module",
  "scripts": {
    "format": "bunx oxfmt",
    "check:global": "bun run --workspaces --if-present check",
    "lint:global": "bun run --workspaces --if-present lint",
    "format:global": "bun run --workspaces --if-present format",
    "format:check:global": "bunx oxfmt --check && bun run --workspaces --if-present format:check",
    "test:global": "bun run --workspaces --if-present test",
    "typecheck:global": "bun run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "@effect/tsgo": "0.69.0",
    "@oxlint/plugins": "1.93.0",
    "oxfmt": "catalog:maintenance",
    "oxlint": "catalog:maintenance",
    "tsrs": "catalog:build",
    "typescript": "catalog:build"
  },
  "patchedDependencies": {
    "@alchemy.run/cloudflare@2.0.0-beta.87": "patches/@alchemy.run%2Fcloudflare@2.0.0-beta.87.patch"
  }
}
