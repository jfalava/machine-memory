{
  "name": "@machine-memory/docs",
  "version": "0.20.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "prebuild": "bun run sync:mcp",
    "check": "bun typecheck && bun lint",
    "deploy": "wrangler deploy",
    "dev": "astro dev --host",
    "format": "prettier --write src && oxfmt",
    "format:check": "prettier --check src",
    "lint": "bun run lint:oxlint && bun run lint:astro && bun run lint:docs",
    "lint:astro": "eslint \"src/**/*.astro\"",
    "lint:astro:fix": "eslint \"src/**/*.astro\" --fix",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "lint:fix": "bun run lint:oxlint:fix && bun run lint:astro:fix && bun run lint:docs:fix",
    "lint:oxlint": "oxlint src",
    "lint:oxlint:fix": "oxlint src --fix",
    "predeploy": "bun typecheck && bun run build",
    "prepreview:cf": "astro build",
    "preview": "astro preview",
    "preview:cf": "wrangler dev",
    "sync:mcp": "bun scripts/sync-mcp-installer.ts",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "0.14.1",
    "@fontsource/google-sans-code": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/zilla-slab": "5.3.0",
    "@iconify-json/ph": "1.2.2",
    "astro": "7.3.2",
    "astro-icon": "1.2.0",
    "astro-og-canvas": "0.13.2",
    "canvaskit-wasm": "0.42.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "@typescript-eslint/parser": "8.70.0",
    "cross-spawn": "7.0.6",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "oxfmt": "catalog:maintenance",
    "oxlint": "catalog:build",
    "oxlint-tsgolint": "catalog:build",
    "pagefind": "1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "satteri": "^0.10.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "catalog:build"
  },
  "optionalDependencies": {
    "@bruits/satteri-darwin-arm64": "0.9.5",
    "@bruits/satteri-darwin-x64": "0.9.5",
    "@bruits/satteri-linux-arm64-gnu": "0.9.5",
    "@bruits/satteri-linux-arm64-musl": "0.9.5",
    "@bruits/satteri-linux-x64-gnu": "0.9.5",
    "@bruits/satteri-linux-x64-musl": "0.9.5",
    "@bruits/satteri-wasm32-wasi": "0.9.5",
    "@bruits/satteri-win32-arm64-msvc": "0.9.5",
    "@bruits/satteri-win32-x64-msvc": "0.9.5"
  }
}
