)"

if ! command -v base64 >/dev/null 2>&1; then
  die 'base64 is required to decode the managed AGENTS.md block.'
fi
if ! command -v python3 >/dev/null 2>&1; then
  die 'python3 is required to splice the managed AGENTS.md block.'
fi

decode_b64() {
  # GNU coreutils uses -d; BSD/macOS uses -D.
  if printf '%s' "$1" | base64 -d 2>/dev/null; then
    return 0
  fi
  printf '%s' "$1" | base64 -D
}

managed_block="$(decode_b64 "${MEMORY_BLOCK_B64}")" \
  || die 'could not decode managed AGENTS.md block.'
case "${managed_block}" in
  *$'\n') ;;
  *) managed_block="${managed_block}"$'\n' ;;
esac

start_marker='<!-- machine-memory:start -->'
end_marker='<!-- machine-memory:end -->'

if [[ -f "${agents_md}" ]]; then
  existing="$(cat "${agents_md}")"
  action='Updated'
else
  existing=''
  action='Created'
  mkdir -p "$(dirname "${agents_md}")"
fi

tmp="$(mktemp 2>/dev/null || mktemp -t machine-memory-init-mcp)"
cleanup() {
  rm -f "${tmp}"
}
trap cleanup EXIT

MM_EXISTING="${existing}" MM_MANAGED="${managed_block}" \
MM_START="${start_marker}" MM_END="${end_marker}" \
python3 - <<'PY' > "${tmp}"
import os

existing = os.environ["MM_EXISTING"]
managed = os.environ["MM_MANAGED"]
start = os.environ["MM_START"]
end = os.environ["MM_END"]

s = existing.find(start)
e = existing.find(end, s) if s >= 0 else -1
if s >= 0 and e >= 0:
    after = existing[e + len(end) :]
    out = existing[:s] + managed.rstrip("\n") + "\n"
    if after:
        out += after.lstrip("\n")
        if not out.endswith("\n"):
            out += "\n"
else:
    body = existing.rstrip()
    out = (body + ("\n\n" if body else "") + managed.rstrip("\n") + "\n")

print(out, end="")
PY

mv -f "${tmp}" "${agents_md}"
trap - EXIT

printf '%s %s\n' "${action}" "${agents_md}"
printf 'Backend  mcp (MCP tools; no CLI)\n'
printf 'Next     connect an OAuth MCP client to https://<worker-url>/mcp\n'
printf 'Docs     https://machine-memory.jfa.dev/docs/mcp/init\n'
